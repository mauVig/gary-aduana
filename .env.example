# ── Envío del formulario de contacto ────────────────────────────────────────
# La integración de Resend del Vercel Marketplace crea RESEND_API_KEY sola en
# el proyecto. En local, copiá este archivo a .env.local y completá los valores.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# A dónde llegan las consultas. Cambiar acá si en el futuro se migra a un
# buzón propio del dominio; no hace falta tocar código.
CONTACTO_EMAIL_DESTINO=despachantegary@gmail.com

# Remitente. El dominio tiene que estar verificado en Resend.
CONTACTO_EMAIL_REMITENTE=Web Estudio Gary <web@send.gary-global-trade.com.ar>

# ── Sitio ───────────────────────────────────────────────────────────────────
# Opcional: si no se define, se usa https://www.gary-global-trade.com.ar
NEXT_PUBLIC_SITE_URL=https://www.gary-global-trade.com.ar
